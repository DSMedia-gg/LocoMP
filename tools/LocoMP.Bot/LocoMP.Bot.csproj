<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless test player - the no-second-PC rig. A simulated client that
       joins a real LocoMP session over UDP (or Loopback in tests) and streams synthetic avatar
       poses. Serves avatar bring-up on one PC today, join/leave churn testing tomorrow, and
       dedicated-server soak runs (hours-long, many bots, in a container). Dev tool only -
       never shipped in the mod zip. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>LocoMP.Bot</AssemblyName>
    <RootNamespace>LocoMP.Bot</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LocoMP.Core\LocoMP.Core.csproj" />
    <ProjectReference Include="..\..\src\LocoMP.Transport\LocoMP.Transport.csproj" />
  </ItemGroup>

</Project>
